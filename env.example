# Activa la búsqueda web amplia. Obtén tu clave en https://brave.com/search/api/
BRAVE_SEARCH_API_KEY=

# Filtra y puntúa los candidatos encontrados por Brave con Gemini. Es una clave
# privada del servidor: no uses el prefijo NEXT_PUBLIC_.
GEMINI_API_KEY=

# Opcional. Gemini 3.5 Flash-Lite es el valor predeterminado con nivel gratuito.
GEMINI_MODEL=gemini-3.5-flash-lite

# Datos públicos del proyecto Supabase. Se obtienen en el botón Connect.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
